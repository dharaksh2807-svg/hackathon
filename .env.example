# Obtain values from your own Supabase project settings. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, highly privileged. NEVER use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Exact public origin; required behind a TLS-terminating reverse proxy.
FAIRSHIFT_APP_ORIGIN=
